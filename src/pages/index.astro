---
import Layout from '@ui/layouts/Layout.astro'
import { ContactButton } from '@ui/components/ContactButton'
import { Navigation } from '@ui/components/UrlContext/Navigation'
import { TabView } from '@ui/components/UrlContext/TabView'
---

<Layout
  title='Kevin Cole | Full Stack Software Developer'
  description='Full stack software developer with 20+ years of experience building web applications, APIs, and cloud infrastructure. Specializing in TypeScript, React, Node.js, Laravel, and AWS.'
  preview='/preview.png'
>
  <main class='h-full overflow-y-auto'>
    <Navigation client:load />
    <ContactButton client:load />
    <TabView client:load />
  </main>
</Layout>
